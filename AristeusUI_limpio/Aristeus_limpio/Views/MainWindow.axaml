<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
        xmlns:vm="using:Aristeus_limpio.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="Aristeus_limpio.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Aristeus - Panel de Control">

    <Grid RowDefinitions="Auto, *">
        
        <!-- Barra superior con título y controles de la aplicación -->
        <Border Grid.Row="0" Padding="15,10" Background="{DynamicResource SukiBackgroundBrush}">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" Text="Panel de Control Aristeus" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="15"/>
                
                <!-- Botón alternativo limpio para estilos o cambiar de vista si se requiere -->
                <Button Grid.Column="1" Content="Tema" Classes="Flat" />
            </Grid>
        </Border>

        <!-- Pestañas principales estilo navegador -->
        <TabControl Grid.Row="1" Margin="10">
            
            <TabItem Header="Grass-Gauge">
                <TextBlock Text="Contenido de Grass-Gauge" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            </TabItem>

            <TabItem Header="Cattle-Vision">
                <TextBlock Text="Contenido de Cattle-Vision" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            </TabItem>

            <TabItem Header="Sentry-Ward">
                <TextBlock Text="Contenido de Sentry-Ward" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            </TabItem>
            
        </TabControl>
    </Grid>

</suki:SukiWindow>