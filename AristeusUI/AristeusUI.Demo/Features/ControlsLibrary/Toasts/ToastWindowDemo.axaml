<aristeus:AristeusWindow x:Class="AristeusUI.Demo.Features.ControlsLibrary.Toasts.ToastWindowDemo"
                 xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:aristeus="https://github.com/kikipoulet/AristeusUI"
                 Title="Toast Window Demo"
                 Width="720"
                 Height="400">
    <aristeus:AristeusWindow.Hosts>
        <aristeus:AristeusToastHost Name="ToastHost"/>
    </aristeus:AristeusWindow.Hosts>
    <Grid RowDefinitions="Auto,*">
        <aristeus:GlassCard Classes="HeaderCard">
            <aristeus:GroupBox Header="Toasts">
                <StackPanel Classes="HeaderContent">
                    <TextBlock>
                        Demos the ability for individual windows (or the main window) to be addressed by the toast system.
                    </TextBlock>
                </StackPanel>
            </aristeus:GroupBox>
        </aristeus:GlassCard>
        <ScrollViewer Grid.Row="1">
            <WrapPanel Classes="PageContainer">
                <aristeus:GlassCard>
                    <aristeus:GroupBox Header="Show In This Window">
                        <Button Margin="15,10,15,0"
                                Click="ShowToastInThisWindowClicked"
                                Content="Show Toast" />
                    </aristeus:GroupBox>
                </aristeus:GlassCard>
                <aristeus:GlassCard>
                    <aristeus:GroupBox Header="Show In MainWindow">
                        <Button Margin="15,10,15,0"
                                Click="ShowToastInMainWindowClicked"
                                Content="Show Toast" />
                    </aristeus:GroupBox>
                </aristeus:GlassCard>
                <aristeus:GlassCard>
                    <aristeus:GroupBox Header="Show In Both Windows">
                        <Button Margin="15,10,15,0"
                                Click="ShowToastInBothWindowsClicked"
                                Content="Show Toast" />
                    </aristeus:GroupBox>
                </aristeus:GlassCard>
            </WrapPanel>
        </ScrollViewer>
    </Grid>
</aristeus:AristeusWindow>
