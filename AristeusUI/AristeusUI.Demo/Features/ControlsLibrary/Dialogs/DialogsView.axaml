<UserControl x:Class="AristeusUI.Demo.Features.ControlsLibrary.Dialogs.DialogsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dialogs="clr-namespace:AristeusUI.Demo.Features.ControlsLibrary.Dialogs"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:aristeus="https://github.com/kikipoulet/AristeusUI"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:DataType="dialogs:DialogsViewModel"
             mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">
        <aristeus:GlassCard Classes="HeaderCard">
            <aristeus:GroupBox Header="Dialogs">
                <StackPanel Classes="HeaderContent">
                    <TextBlock>
                        AristeusUI provides a rich dialog experience out of the box, allowing the display of any arbitrary control, view or ViewModel (with suitable ViewLocator defined) as a dialog.
                    </TextBlock>
                    <TextBlock>
                        As the API for this resides entirely in C#, the source for the examples can be viewed on GitHub at the URL below.
                    </TextBlock>
                    <HyperlinkButton Content="Source Here." NavigateUri="https://github.com/kikipoulet/AristeusUI/blob/main/AristeusUI.Demo/Features/ControlsLibrary/Dialogs/DialogsViewModel.cs" />
                    <TextBlock>
                        Click any of the following buttons to open up a dialog.
                    </TextBlock>

                </StackPanel>
            </aristeus:GroupBox>
        </aristeus:GlassCard>


        <ScrollViewer Grid.Row="1" Margin="32">
            <StackPanel Spacing="32">
                <Expander ExpandDirection="Down"
                          Header="Dialogs"
                          IsExpanded="True">
                    <ScrollViewer>
                        <WrapPanel Classes="PageContainer">
                            <aristeus:GlassCard Width="250">
                                <aristeus:GroupBox Header="Standard">
                                    <Button Margin="15,10,15,0" Classes="Flat"
                                            VerticalAlignment="Top"
                                            Command="{Binding OpenStandardDialogCommand}"
                                            Content="Open" />
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>
                            <aristeus:GlassCard Width="250">
                                <aristeus:GroupBox Header="Long">
                                    <Button Margin="15,10,15,0" Classes="Flat"
                                            VerticalAlignment="Top"
                                            Command="{Binding OpenLongDialogCommand}"
                                            Content="Open" />
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>
                            <aristeus:GlassCard Width="250">
                                <aristeus:GroupBox Header="Multi Option">
                                    <Button Margin="15,10,15,0" Classes="Flat"
                                            VerticalAlignment="Top"
                                            Command="{Binding OpenMultiOptionDialogCommand}"
                                            Content="Open" />
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>
                            <aristeus:GlassCard Width="250">
                                <aristeus:GroupBox Header="Background Closable">
                                    <Button Margin="15,10,15,0" Classes="Flat"
                                            VerticalAlignment="Top"
                                            Command="{Binding OpenBackgroundCloseDialogCommand}"
                                            Content="Open" />
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>
                            <aristeus:GlassCard Width="250">
                                <aristeus:GroupBox Header="ViewModel">
                                    <Button Margin="15,10,15,0" Classes="Flat"
                                            VerticalAlignment="Top"
                                            Command="{Binding OpenViewModelDialogCommand}"
                                            Content="Open" />
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>
                            <aristeus:GlassCard Width="250">
                                <aristeus:GroupBox Header="ViewModel With Action Buttons">
                                    <Button Margin="15,10,15,0" Classes="Flat"
                                            VerticalAlignment="Top"
                                            Command="{Binding OpenViewModelWithActionButtonsDialogCommand}"
                                            Content="Open" />
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>
                            <aristeus:GlassCard Width="250">
                                <aristeus:GroupBox Header="Useless">
                                    <TextBlock TextWrapping="Wrap" FontWeight="Bold" Foreground="IndianRed" Text="This is a useless message to show glassmorphism renders above this."></TextBlock>
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>
                        </WrapPanel>
                    </ScrollViewer>
                </Expander>

                <Expander ExpandDirection="Down"
                          Header="Messageboxes"
                          IsExpanded="True">
                    <ScrollViewer>
                        <WrapPanel Classes="PageContainer">
                            <aristeus:GlassCard Width="250">
                                <aristeus:GroupBox Header="Basic">
                                    <StackPanel Spacing="5">
                                        <ComboBox ItemsSource="{Binding NotificationTypes}" SelectedItem="{Binding SelectedType}" />
                                        <Button Margin="15,10,15,0"
                                                VerticalAlignment="Top"
                                                Command="{Binding OpenMessageBoxStyleDialogCommand}"
                                                Content="Open" />
                                    </StackPanel>
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>
                            <aristeus:GlassCard Width="250">
                                <aristeus:GroupBox Header="Async blocking">
                                    <StackPanel Spacing="5">
                                        <ComboBox ItemsSource="{Binding NotificationTypes}" SelectedItem="{Binding SelectedType}" />
                                        <Button Margin="15,10,15,0"
                                                VerticalAlignment="Top"
                                                Command="{Binding OpenAsyncMessageBoxStyleDialogCommand}"
                                                Content="Open" />
                                    </StackPanel>
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>

                            <aristeus:GlassCard Width="250">
                                <aristeus:GroupBox Header="Question">
                                    <Button Margin="15,10,15,0"
                                            VerticalAlignment="Top"
                                            Command="{Binding OpenSimpleQuestionMessageBoxCommand}"
                                            Content="Open" />
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>

                            <aristeus:GlassCard Width="250">
                                <aristeus:GroupBox Header="Advanced Question">
                                    <Grid ColumnDefinitions="Auto,5,*" RowDefinitions="Auto,5,Auto,5,Auto">
                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Text="Icon:" />
                                        <ComboBox Grid.Row="0"
                                                  Grid.Column="2"
                                                  ItemsSource="{Binding MessageBoxIcons}"
                                                  SelectedItem="{Binding SelectedMessageBoxIcon}" />

                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Text="Buttons:" />
                                        <ComboBox Grid.Row="2"
                                                  Grid.Column="2"
                                                  ItemsSource="{Binding MessageBoxButtons}"
                                                  SelectedItem="{Binding SelectedMessageBoxButtons}" />
                                        <Button Grid.Row="4"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                Margin="15,10,15,0"
                                                VerticalAlignment="Top"
                                                Command="{Binding OpenAdvancedQuestionMessageBoxCommand}"
                                                Content="Open" />
                                    </Grid>
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>

                            <aristeus:GlassCard Width="250">
                                <aristeus:GroupBox Header="Custom Markdown">
                                    <StackPanel Spacing="10">
                                        <CheckBox Content="Use alternative header style" IsChecked="{Binding UseAlternativeHeaderStyle}" />
                                        <CheckBox Content="Show header/content separator" IsChecked="{Binding ShowHeaderContentSeparator}" />
                                        <CheckBox Content="Use native window" IsChecked="{Binding UseNativeWindow}" />
                                        <Button Margin="15,10,15,0"
                                                VerticalAlignment="Top"
                                                Command="{Binding OpenCustomMarkdownMessageBoxCommand}"
                                                Content="Open" />
                                    </StackPanel>
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>

                            <aristeus:GlassCard Width="250">
                                <aristeus:GroupBox Header="Animated Header">
                                    <Button Margin="15,10,15,0"
                                            VerticalAlignment="Top"
                                            Command="{Binding OpenAnimatedHeaderMessageBoxCommand}"
                                            Content="Open" />
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>

                            <aristeus:GlassCard Width="250">
                                <aristeus:GroupBox Header="Success">
                                    <Button Margin="15,10,15,0"
                                            VerticalAlignment="Top"
                                            Command="{Binding OpenSuccessMessageBoxCommand}"
                                            Content="Open" />
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>

                            <aristeus:GlassCard Width="250">
                                <aristeus:GroupBox Header="Warning">
                                    <Button Margin="15,10,15,0"
                                            VerticalAlignment="Top"
                                            Command="{Binding OpenWarningMessageBoxCommand}"
                                            Content="Open" />
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>

                            <aristeus:GlassCard Width="250">
                                <aristeus:GroupBox Header="Error">
                                    <Button Margin="15,10,15,0"
                                            VerticalAlignment="Top"
                                            Command="{Binding OpenErrorMessageBoxCommand}"
                                            Content="Open" />
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>

                            <aristeus:GlassCard Width="250">
                                <aristeus:GroupBox Header="Long">
                                    <Button Margin="15,10,15,0"
                                            VerticalAlignment="Top"
                                            Command="{Binding OpenLongMessageBoxCommand}"
                                            CommandParameter="{x:False}"
                                            Content="Open" />
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>

                            <aristeus:GlassCard Width="250">
                                <aristeus:GroupBox Header="Long Native Window">
                                    <Button Margin="15,10,15,0"
                                            VerticalAlignment="Top"
                                            Command="{Binding OpenLongMessageBoxCommand}"
                                            CommandParameter="{x:True}"
                                            Content="Open" />
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>

                            <aristeus:GlassCard Width="250">
                                <aristeus:GroupBox Header="ViewModel">
                                    <Button Margin="15,10,15,0"
                                            VerticalAlignment="Top"
                                            Command="{Binding OpenViewModelMessageBoxCommand}"
                                            Content="Open" />
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>
                        </WrapPanel>
                    </ScrollViewer>
                </Expander>

                <Expander ExpandDirection="Down"
                          Header="Window Demos"
                          IsExpanded="True">
                    <ScrollViewer>
                        <WrapPanel Classes="PageContainer">
                            <aristeus:GlassCard>
                                <aristeus:GroupBox Width="250" Header="Dialog Window">
                                    <Button Margin="15,10,15,0"
                                            VerticalAlignment="Top"
                                            Command="{Binding OpenDialogWindowDemoCommand}"
                                            Content="Open" />
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>

                            <aristeus:GlassCard>
                                <aristeus:GroupBox Width="250" Header="Tool Window">
                                    <Button Margin="15,10,15,0"
                                            VerticalAlignment="Top"
                                            Command="{Binding OpenToolWindowDemoCommand}"
                                            Content="Open" />
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>

                            <aristeus:GlassCard>
                                <aristeus:GroupBox Header="Native Window Dialog Demo">
                                    <Button Margin="15,10,15,0"
                                            VerticalAlignment="Top"
                                            Command="{Binding OpenDialogNativeWindowDemoCommand}"
                                            Content="Open" />
                                </aristeus:GroupBox>
                            </aristeus:GlassCard>
                        </WrapPanel>
                    </ScrollViewer>
                </Expander>
            </StackPanel>

        </ScrollViewer>
    </Grid>
</UserControl>
