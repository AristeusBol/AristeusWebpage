<UserControl x:Class="AristeusUI.Demo.Features.ControlsLibrary.Colors.ColorsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:colors="clr-namespace:AristeusUI.Demo.Features.ControlsLibrary.Colors"
             xmlns:aristeus="https://github.com/kikipoulet/AristeusUI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:theme="clr-namespace:AristeusUI.Theme;assembly=AristeusUI"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:DataType="colors:ColorsViewModel"
             mc:Ignorable="d">
    <Grid RowDefinitions="Auto,*">
        <aristeus:GlassCard Classes="HeaderCard">
            <aristeus:GroupBox Header="Colors">
                <StackPanel Classes="HeaderContent">
                    <TextBlock>Below is a full list of all defined colors that are available either via XAML (DynamicResource) or via Application.Resources.</TextBlock>
                    <TextBlock>Click on any of the colors to copy it's name to your clipboard.</TextBlock>
                </StackPanel>
            </aristeus:GroupBox>
        </aristeus:GlassCard>
        <ScrollViewer Grid.Row="1">
            <ItemsControl theme:ItemsControlExtensions.AnimatedScroll="True" ItemsSource="{Binding Colors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <aristeus:GlassCard Margin="15"
                                        IsInteractive="True"
                                        Command="{Binding $parent[colors:ColorsView].((colors:ColorsViewModel)DataContext).ColorClickedCommand}"
                                        CommandParameter="{Binding}">
                            <aristeus:GroupBox Header="{Binding Name}">
                                <Rectangle Width="50"
                                           Height="50"
                                           Margin="0,7,0,0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Fill="{Binding Brush}"
                                           RadiusX="8"
                                           RadiusY="8"
                                           Stroke="{DynamicResource AristeusBorderBrush}"
                                           StrokeThickness="2">
                                    <Rectangle.Transitions>
                                        <Transitions>
                                            <BrushTransition Property="Fill" Duration="0:0:0.20" />
                                        </Transitions>
                                    </Rectangle.Transitions>
                                </Rectangle>
                            </aristeus:GroupBox>
                        </aristeus:GlassCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Classes="PageContainer" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
