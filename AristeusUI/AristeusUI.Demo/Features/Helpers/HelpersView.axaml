<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="AristeusUI.Demo.Features.Helpers.HelpersView"
    x:DataType="helpers:HelpersViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:X="clr-namespace:AristeusUI.Helpers.ConditionalXAML;assembly=AristeusUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:glassMorphism="clr-namespace:AristeusUI.Controls.GlassMorphism;assembly=AristeusUI"
    xmlns:helpers="clr-namespace:AristeusUI.Demo.Features.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:aristeus="https://github.com/kikipoulet/AristeusUI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="aristeus|AristeusSideMenu /template/ aristeus|GlassCard#Glass">
            <Setter Property="Opacity" Value="0.75" />
        </Style>
    </UserControl.Styles>
    <aristeus:AristeusSideMenu Margin="0">
        <aristeus:AristeusSideMenu.Items>
            <aristeus:AristeusSideMenuItem Classes="Compact" Header="Syntax Helpers">
                <aristeus:AristeusSideMenuItem.Icon>
                    <PathIcon
                        Data="{x:Static aristeus:Icons.ChevronRight}"
                        Foreground="{DynamicResource AristeusLowText}"
                        Height="13"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="13" />

                </aristeus:AristeusSideMenuItem.Icon>
                <aristeus:AristeusSideMenuItem.PageContent>

                    <helpers:SyntaxHelpers />

                </aristeus:AristeusSideMenuItem.PageContent>
            </aristeus:AristeusSideMenuItem>


            <aristeus:AristeusSideMenuItem Classes="Compact" Header="Animation Behaviors">
                <aristeus:AristeusSideMenuItem.Icon>
                    <PathIcon
                        Data="{x:Static aristeus:Icons.ChevronRight}"
                        Foreground="{DynamicResource AristeusLowText}"
                        Height="13"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="13" />
                </aristeus:AristeusSideMenuItem.Icon>
                <aristeus:AristeusSideMenuItem.PageContent>
                    <ScrollViewer>
                        <helpers:AnimationBehaviors />
                    </ScrollViewer>
                </aristeus:AristeusSideMenuItem.PageContent>
            </aristeus:AristeusSideMenuItem>


            <aristeus:AristeusSideMenuItem Classes="Compact" Header="Easy Animations">
                <aristeus:AristeusSideMenuItem.Icon>
                    <PathIcon
                        Data="{x:Static aristeus:Icons.ChevronRight}"
                        Foreground="{DynamicResource AristeusLowText}"
                        Height="13"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="13" />

                </aristeus:AristeusSideMenuItem.Icon>
                <aristeus:AristeusSideMenuItem.PageContent>
                    <ScrollViewer>
                        <helpers:Easy_Animations />
                    </ScrollViewer>
                </aristeus:AristeusSideMenuItem.PageContent>
            </aristeus:AristeusSideMenuItem>

            <aristeus:AristeusSideMenuItem Classes="Compact" Header="Aristeus Easings">
                <aristeus:AristeusSideMenuItem.Icon>
                    <PathIcon
                        Data="{x:Static aristeus:Icons.ChevronRight}"
                        Foreground="{DynamicResource AristeusLowText}"
                        Height="13"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="13" />

                </aristeus:AristeusSideMenuItem.Icon>
                <aristeus:AristeusSideMenuItem.PageContent>
                    <ScrollViewer>
                        <helpers:CustomEasings />
                    </ScrollViewer>
                </aristeus:AristeusSideMenuItem.PageContent>
            </aristeus:AristeusSideMenuItem>

            <!-- <aristeus:AristeusSideMenuItem Classes="Compact" Header="Spring Easing">
                <aristeus:AristeusSideMenuItem.Icon>
                    <PathIcon
                        Data="{x:Static aristeus:Icons.ChevronRight}"
                        Foreground="{DynamicResource AristeusLowText}"
                        Height="13"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="13" />

                </aristeus:AristeusSideMenuItem.Icon>
                <aristeus:AristeusSideMenuItem.PageContent>
                    <ScrollViewer>
                        <helpers:SpringEasing />
                    </ScrollViewer>
                </aristeus:AristeusSideMenuItem.PageContent>
            </aristeus:AristeusSideMenuItem> -->

            <!-- <aristeus:AristeusSideMenuItem Classes="Compact" Header="Organic Move">
                <aristeus:AristeusSideMenuItem.Icon>
                    <PathIcon Width="13"
                              Height="13"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{x:Static aristeus:Icons.ChevronRight}"
                              Foreground="{DynamicResource AristeusLowText}" />

                </aristeus:AristeusSideMenuItem.Icon>
                <aristeus:AristeusSideMenuItem.PageContent>
                    <ScrollViewer>
                        <helpers:OrganicMove />
                    </ScrollViewer>
                </aristeus:AristeusSideMenuItem.PageContent>
            </aristeus:AristeusSideMenuItem>-->

            <aristeus:AristeusSideMenuItem Classes="Compact" Header="Squish Effect">
                <aristeus:AristeusSideMenuItem.Icon>
                    <PathIcon
                        Data="{x:Static aristeus:Icons.ChevronRight}"
                        Foreground="{DynamicResource AristeusLowText}"
                        Height="13"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="13" />

                </aristeus:AristeusSideMenuItem.Icon>
                <aristeus:AristeusSideMenuItem.PageContent>
                    <ScrollViewer>
                        <helpers:PullingEffect />
                    </ScrollViewer>
                </aristeus:AristeusSideMenuItem.PageContent>
            </aristeus:AristeusSideMenuItem>

            <!--  Other Pages  -->

        </aristeus:AristeusSideMenu.Items>


        <aristeus:AristeusSideMenu.HeaderContent>
            <Panel />
        </aristeus:AristeusSideMenu.HeaderContent>

        <aristeus:AristeusSideMenu.FooterContent>
            <Panel />
        </aristeus:AristeusSideMenu.FooterContent>
    </aristeus:AristeusSideMenu>
</UserControl>
