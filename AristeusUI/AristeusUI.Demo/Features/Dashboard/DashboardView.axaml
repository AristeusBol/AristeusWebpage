<UserControl x:Class="AristeusUI.Demo.Features.Dashboard.DashboardView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:dashboard="clr-namespace:AristeusUI.Demo.Features.Dashboard"
             xmlns:icon="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:aristeus="https://github.com/kikipoulet/AristeusUI"
             d:DesignHeight="650"
             d:DesignWidth="800"
             x:DataType="dashboard:DashboardViewModel"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">

        <WrapPanel Margin="15"
                   aristeus:WrapPanelExtensions.AnimatedScroll="True"
                   Orientation="Horizontal">

            <!--  Login  -->
            <Grid Margin="15">
                <aristeus:GlassCard Width="300" Margin="0,0,0,25">
                    <aristeus:BusyArea Name="BusySignIn"
                                   BusyText="Signing In..."
                                   IsBusy="{Binding IsLoggingIn}">
                        <StackPanel>
                            <icon:MaterialIcon Width="30"
                                               Height="30"
                                               Margin="10"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AristeusPrimaryColor}"
                                               Kind="MicrosoftEdge" />
                            <TextBlock Margin="0,5,0,27"
                                       HorizontalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="DemiBold"
                                       Text="Sign-in to your account" />
                            <TextBlock Margin="6,0,0,3"
                                       FontWeight="DemiBold"
                                       Foreground="{DynamicResource AristeusLowText}"
                                       Text="Username" />
                            <TextBox aristeus:TextBoxExtensions.Prefix="{icon:MaterialIconExt Kind=User}"
                                     Classes="clearButton"
                                     Text="{Binding Username}"
                                     PlaceholderText="John" />
                            <TextBlock Margin="6,18,0,3"
                                       FontWeight="DemiBold"
                                       Foreground="{DynamicResource AristeusLowText}"
                                       Text="Password" />
                            <TextBox Name="PasswordTextBox"
                                     Margin="0,0,0,25"
                                     aristeus:TextBoxExtensions.AddDeleteButton="True"
                                     aristeus:TextBoxExtensions.Prefix="{icon:MaterialIconExt Kind=Password}"
                                     Classes="revealPasswordButton"
                                     PasswordChar="*"
                                     Text="{Binding Password}"
                                     PlaceholderText="*******" />
                        </StackPanel>
                    </aristeus:BusyArea>
                </aristeus:GlassCard>
                <Button Name="ButtonSignIn"
                        Width="160"
                        Height="40"
                        Margin="0,0,0,7"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        aristeus:ButtonExtensions.ShowProgress="{Binding IsLoggingIn}"
                        Classes="Flat Rounded"
                        Command="{Binding LoginCommand}"
                        FontWeight="DemiBold">
                    Sign In
                </Button>
            </Grid>

            <!--  Upload progress  -->
            <StackPanel>
                <aristeus:GlassCard Width="300"
                                Height="80"
                                Margin="15">
                    <Grid>
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock FontSize="16"
                                       FontWeight="DemiBold"
                                       Text="Uploading File .." />
                            <TextBlock Margin="2,4,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource AristeusLowText}"
                                       Text="Presentation.pdf" />
                        </StackPanel>
                        <aristeus:CircleProgressBar Width="37"
                                                Height="37"
                                                Margin="-55,-65,-10,-65"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                StrokeWidth="4"
                                                Value="67">
                            <TextBlock Margin="1,1,0,0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="DemiBold"
                                       Text="67" />
                        </aristeus:CircleProgressBar>
                    </Grid>
                </aristeus:GlassCard>

                <!--  work progress  -->
                <aristeus:GlassCard Width="300"
                                Margin="15"
                                Classes="Card">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Left"
                                   FontSize="16"
                                   FontWeight="DemiBold"
                                   Text="Daily Progress" />
                        <Grid Margin="0,18,0,0">
                            <TextBlock HorizontalAlignment="Left"
                                       FontSize="12"
                                       FontWeight="DemiBold"
                                       Foreground="{DynamicResource AristeusLowText}"
                                       Text="Project Workforce" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock FontSize="13"
                                           Foreground="Green"
                                           Text="32.21%" />
                                <icon:MaterialIcon Margin="5,0,0,0"
                                                   Foreground="Green"
                                                   Kind="ArrowUp" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Margin="0,1,0,0" Value="16" />
                        <Grid Margin="0,13,0,0">
                            <TextBlock HorizontalAlignment="Left"
                                       FontSize="12"
                                       FontWeight="DemiBold"
                                       Foreground="{DynamicResource AristeusLowText}"
                                       Text="Project Velocity" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock FontSize="13"
                                           Foreground="Red"
                                           Text="7.18%" />
                                <icon:MaterialIcon Margin="5,0,0,0"
                                                   Foreground="Red"
                                                   Kind="ArrowDown" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Margin="0,1,0,0" Value="62" />

                        <Grid Margin="0,13,0,0">
                            <TextBlock HorizontalAlignment="Left"
                                       FontSize="12"
                                       FontWeight="DemiBold"
                                       Foreground="{DynamicResource AristeusLowText}"
                                       Text="Critical Hours" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock FontSize="13"
                                           Foreground="Green"
                                           Text="16.89%" />
                                <icon:MaterialIcon Margin="5,0,0,0"
                                                   Foreground="Green"
                                                   Kind="ArrowUp" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Margin="0,1,0,0" Value="34" />

                    </StackPanel>
                </aristeus:GlassCard>
            </StackPanel>

            <!--  humidity  -->
            <aristeus:GlassCard Width="300"
                            Height="320"
                            Margin="15"
                            VerticalAlignment="Top">
                <Grid>
                    <TextBlock FontSize="16"
                               FontWeight="DemiBold"
                               Text="Humidity" />
                    <Viewbox Width="175"
                             Height="175"
                             Margin="0,0,0,5"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <aristeus:WaveProgress Value="{Binding Value, ElementName=SliderT}" />
                    </Viewbox>
                    <DockPanel VerticalAlignment="Bottom">
                        <icon:MaterialIcon Width="20"
                                           Height="20"
                                           DockPanel.Dock="Left"
                                           Foreground="#666666"
                                           Kind="TemperatureLow" />
                        <icon:MaterialIcon Width="20"
                                           Height="20"
                                           DockPanel.Dock="Right"
                                           Foreground="#666666"
                                           Kind="TemperatureHigh" />
                        <Slider Name="SliderT"
                                Margin="8,0"
                                Maximum="100"
                                Minimum="0"
                                Value="23" />
                    </DockPanel>
                </Grid>
            </aristeus:GlassCard>

            <!--  notifications  -->
            <aristeus:GlassCard Width="500"
                            Margin="15"
                            VerticalAlignment="Top">
                <Grid>
                    <StackPanel>
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       FontWeight="DemiBold"
                                       Text="Notify me when .." />
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                    <CheckBox IsChecked="True" />
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource AristeusLowText}"
                                               Text="Daily updates" />
                                </StackPanel>
                                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                    <CheckBox IsChecked="True" />
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource AristeusLowText}"
                                               Text="New event" />
                                </StackPanel>
                                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                    <CheckBox IsChecked="False" />
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource AristeusLowText}"
                                               Text="When added on new team" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <Grid Margin="0,30,0,0">
                            <ToggleSwitch HorizontalAlignment="Right"
                                          VerticalAlignment="Top"
                                          Classes="Switch"
                                          IsChecked="True" />
                            <TextBlock HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       FontWeight="DemiBold"
                                       Text="Mobile Notifications" />

                            <TextBlock Width="300"
                                       Margin="0,22,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom"
                                       FontSize="13"
                                       Foreground="{DynamicResource AristeusLowText}"
                                       Text="Receive push notifications on your mobile phone."
                                       TextWrapping="Wrap" />
                        </Grid>
                        <Grid Margin="0,30,0,0">
                            <ToggleSwitch HorizontalAlignment="Right"
                                          VerticalAlignment="Top"
                                          Classes="Switch"
                                          IsChecked="False" />
                            <TextBlock HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       FontWeight="DemiBold"
                                       Text="Desktop Notifications" />
                            <TextBlock Width="300"
                                       Margin="0,22,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Bottom"
                                       FontSize="13"
                                       Foreground="{DynamicResource AristeusLowText}"
                                       Text="Receive push notifications on your computer."
                                       TextWrapping="Wrap" />
                        </Grid>
                        <StackPanel Margin="0,30,0,0">
                            <TextBlock HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       FontWeight="DemiBold"
                                       Text="Language" />

                            <RadioButton Margin="0,13,0,0">
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource AristeusLowText}"
                                           Text="English" />
                            </RadioButton>
                            <RadioButton Margin="0,5,0,0" IsChecked="True">
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource AristeusLowText}"
                                           Text="Chinese" />
                            </RadioButton>
                            <RadioButton Margin="0,5,0,0">
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource AristeusLowText}"
                                           Text="Japanese" />
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>
                    <Button Margin="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Classes="Basic"
                            Command="{Binding ShowDialogCommand}"
                            Content="Create Link" />
                </Grid>
            </aristeus:GlassCard>

            <!--  Invoices  -->
            <StackPanel>
                <aristeus:GlassCard Width="430"
                                Height="308"
                                Margin="15">
                    <TabControl>
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock FontSize="16" Text="Invoices" />
                            </TabItem.Header>
                            <Grid>
                                <DataGrid Margin="15,0,15,10"
                                          VerticalAlignment="Top"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding Invoices}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Id}" Header="Id" />
                                        <DataGridTextColumn Binding="{Binding BillingName}" Header="BillingName" />
                                        <DataGridTextColumn Binding="{Binding AmountPaid}" Header="AmountPaid" />
                                        <DataGridCheckBoxColumn Binding="{Binding Paid}" Header="Paid" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock FontSize="16" Text="Questions" />
                            </TabItem.Header>
                            <StackPanel Margin="0,10,0,0">
                                <Expander>
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <icon:MaterialIcon Foreground="{DynamicResource AristeusText}" Kind="Lock" />
                                            <TextBlock Text="Test Lock" />
                                        </StackPanel>
                                    </Expander.Header>

                                    <TextBlock Margin="15,15"
                                               FontSize="13"
                                               TextWrapping="Wrap">
                                        We understand that things change. You can cancel your plan at any time and we'll refund you.
                                    </TextBlock>
                                </Expander>

                                <Expander Header="Can I change my plan later ?">
                                    <TextBlock Margin="20,5">Answer</TextBlock>
                                </Expander>

                                <Expander Header="How do I change my account email ?">
                                    <TextBlock Margin="20,5">Answer</TextBlock>
                                </Expander>

                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </aristeus:GlassCard>
                <aristeus:GlassCard Width="430" Margin="15">

                    <aristeus:Stepper Margin="-30,0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Index="{Binding StepperIndex}"
                                  Steps="{Binding Steps}" />

                </aristeus:GlassCard>
            </StackPanel>

            <!--  Payment plans  -->
            <aristeus:GlassCard Width="961"
                            Height="270"
                            Margin="15">
                <aristeus:GroupBox>
                    <aristeus:GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <icon:MaterialIcon Foreground="{DynamicResource AristeusLowText}" Kind="Dollar" />
                            <TextBlock Margin="5,0,0,0" Text="Change Plan" />
                        </StackPanel>
                    </aristeus:GroupBox.Header>
                    <WrapPanel Margin="0,25,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <RadioButton Width="210"
                                     Height="138"
                                     Margin="7"
                                     Classes="GigaChips"
                                     IsChecked="True">
                            <StackPanel HorizontalAlignment="Left" Spacing="0,8">
                                <TextBlock FontSize="12"
                                           FontWeight="DemiBold"
                                           Foreground="{DynamicResource AristeusLowText}"
                                           Text="HOBBY" />
                                <TextBlock FontSize="23"
                                           FontWeight="DemiBold"
                                           Text="1 Gb" />
                                <TextBlock FontSize="15"
                                           Foreground="{DynamicResource AristeusLowText}"
                                           Text="Plan for a moderate use as hobby."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Width="210"
                                     Height="138"
                                     Margin="7"
                                     Classes="GigaChips">
                            <StackPanel HorizontalAlignment="Left" Spacing="0,8">
                                <TextBlock FontSize="12"
                                           FontWeight="DemiBold"
                                           Foreground="{DynamicResource AristeusLowText}"
                                           Text="PROFESSIONAL" />
                                <TextBlock FontSize="23"
                                           FontWeight="DemiBold"
                                           Text="5 Gb" />
                                <TextBlock FontSize="15"
                                           Foreground="{DynamicResource AristeusLowText}"
                                           Text="Professional use in an application."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Width="210"
                                     Height="138"
                                     Margin="7"
                                     Classes="GigaChips">
                            <StackPanel HorizontalAlignment="Left" Spacing="0,8">
                                <TextBlock FontSize="12"
                                           FontWeight="DemiBold"
                                           Foreground="{DynamicResource AristeusLowText}"
                                           Text="COMPANY" />
                                <TextBlock FontSize="23"
                                           FontWeight="DemiBold"
                                           Text="50 Gb" />
                                <TextBlock FontSize="15"
                                           Foreground="{DynamicResource AristeusLowText}"
                                           Text="Plan for a industrial use in a company."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButton>
                    </WrapPanel>
                </aristeus:GroupBox>
            </aristeus:GlassCard>

            <aristeus:GlassCard Width="1000"
                            Height="500"
                            Margin="15"
                            Padding="-2"
                            ClipToBounds="True">
                <aristeus:AristeusSideMenu IsSearchEnabled="True">
                    <aristeus:AristeusSideMenu.Items>
                        <aristeus:AristeusSideMenuItem Classes="Compact" Header="Page Title">
                            <aristeus:AristeusSideMenuItem.Icon>
                                <PathIcon Width="13"
                                          Height="13"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="{x:Static aristeus:Icons.Search}"
                                          Foreground="{DynamicResource AristeusLowText}" />
                            </aristeus:AristeusSideMenuItem.Icon>
                            <aristeus:AristeusSideMenuItem.PageContent>
                                <Panel />
                            </aristeus:AristeusSideMenuItem.PageContent>
                        </aristeus:AristeusSideMenuItem>

                        <aristeus:AristeusSideMenuItem Classes="Compact" Header="Collection">
                            <aristeus:AristeusSideMenuItem.Icon>
                                <PathIcon Width="13"
                                          Height="13"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="{x:Static aristeus:Icons.Search}"
                                          Foreground="{DynamicResource AristeusLowText}" />
                            </aristeus:AristeusSideMenuItem.Icon>
                            <aristeus:AristeusSideMenuItem.PageContent>
                                <Panel />
                            </aristeus:AristeusSideMenuItem.PageContent>
                            <aristeus:AristeusSideMenuItem.Items>



                                <aristeus:AristeusSideMenuItem Classes="Compact" Header="Page Title">
                                    <aristeus:AristeusSideMenuItem.Icon>
                                        <PathIcon Width="13"
                                                  Height="13"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="{x:Static aristeus:Icons.Search}"
                                                  Foreground="{DynamicResource AristeusLowText}" />
                                    </aristeus:AristeusSideMenuItem.Icon>
                                    <aristeus:AristeusSideMenuItem.PageContent>
                                        <Panel />
                                    </aristeus:AristeusSideMenuItem.PageContent>
                                </aristeus:AristeusSideMenuItem>
                                <aristeus:AristeusSideMenuItem Classes="Compact" Header="Page Title">
                                    <aristeus:AristeusSideMenuItem.Icon>
                                        <PathIcon Width="13"
                                                  Height="13"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="{x:Static aristeus:Icons.Search}"
                                                  Foreground="{DynamicResource AristeusLowText}" />
                                    </aristeus:AristeusSideMenuItem.Icon>
                                    <aristeus:AristeusSideMenuItem.PageContent>
                                        <Panel />
                                    </aristeus:AristeusSideMenuItem.PageContent>
                                </aristeus:AristeusSideMenuItem>



                            </aristeus:AristeusSideMenuItem.Items>
                        </aristeus:AristeusSideMenuItem>

                        <aristeus:AristeusSideMenuItem Classes="Compact" Header="Collection">
                            <aristeus:AristeusSideMenuItem.Icon>
                                <PathIcon Width="13"
                                          Height="13"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="{x:Static aristeus:Icons.Search}"
                                          Foreground="{DynamicResource AristeusLowText}" />
                            </aristeus:AristeusSideMenuItem.Icon>
                            <aristeus:AristeusSideMenuItem.PageContent>
                                <Panel />
                            </aristeus:AristeusSideMenuItem.PageContent>
                            <aristeus:AristeusSideMenuItem.Items>



                                <aristeus:AristeusSideMenuItem Classes="Compact" Header="Page Title">
                                    <aristeus:AristeusSideMenuItem.Icon>
                                        <PathIcon Width="13"
                                                  Height="13"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="{x:Static aristeus:Icons.Search}"
                                                  Foreground="{DynamicResource AristeusLowText}" />
                                    </aristeus:AristeusSideMenuItem.Icon>
                                    <aristeus:AristeusSideMenuItem.PageContent>
                                        <Panel />
                                    </aristeus:AristeusSideMenuItem.PageContent>
                                </aristeus:AristeusSideMenuItem>
                                <aristeus:AristeusSideMenuItem Classes="Compact" Header="Page Title">
                                    <aristeus:AristeusSideMenuItem.Icon>
                                        <PathIcon Width="13"
                                                  Height="13"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="{x:Static aristeus:Icons.Search}"
                                                  Foreground="{DynamicResource AristeusLowText}" />
                                    </aristeus:AristeusSideMenuItem.Icon>
                                    <aristeus:AristeusSideMenuItem.PageContent>
                                        <Panel />
                                    </aristeus:AristeusSideMenuItem.PageContent>
                                </aristeus:AristeusSideMenuItem>



                            </aristeus:AristeusSideMenuItem.Items>
                        </aristeus:AristeusSideMenuItem>

                        <aristeus:AristeusSideMenuItem Classes="Compact" Header="Page Title">
                            <aristeus:AristeusSideMenuItem.Icon>
                                <PathIcon Width="13"
                                          Height="13"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="{x:Static aristeus:Icons.Search}"
                                          Foreground="{DynamicResource AristeusLowText}" />
                            </aristeus:AristeusSideMenuItem.Icon>
                            <aristeus:AristeusSideMenuItem.PageContent>
                                <Panel />
                            </aristeus:AristeusSideMenuItem.PageContent>
                        </aristeus:AristeusSideMenuItem>
                        <!--  Other Pages  -->

                    </aristeus:AristeusSideMenu.Items>


                    <aristeus:AristeusSideMenu.HeaderContent>
                        <Image Width="80"
                               Height="80"
                               Margin="30,10,30,30"
                               Classes="AppIcon"
                               Source="../../Assets/OIG.N5o-removebg-preview.png" />
                    </aristeus:AristeusSideMenu.HeaderContent>

                    <aristeus:AristeusSideMenu.FooterContent>
                        <!--  Footer Content  -->
                    </aristeus:AristeusSideMenu.FooterContent>
                </aristeus:AristeusSideMenu>
            </aristeus:GlassCard>

            <aristeus:GlassCard Width="1000"
                            Height="500"
                            Margin="15"
                            ClipToBounds="True">
                <aristeus:GroupBox>
                    <aristeus:GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <icon:MaterialIcon Foreground="{DynamicResource AristeusLowText}" Kind="People" />
                            <TextBlock Margin="5,0,0,0" Text="Customers" />
                        </StackPanel>
                    </aristeus:GroupBox.Header>
                    <aristeus:AristeusSideMenu ItemsSource="{Binding Invoices}" UseCustomContent="True">

                        <aristeus:AristeusSideMenu.Content>
                            <StackPanel Margin="20">
                                <TextBlock Classes="h3" Text="{Binding $parent[aristeus:AristeusSideMenu].((dashboard:InvoiceViewModel)SelectedItem).BillingName}" />
                                <StackPanel IsVisible="{Binding $parent[aristeus:AristeusSideMenu].((dashboard:InvoiceViewModel)SelectedItem).Paid}" Orientation="Horizontal">
                                    <TextBlock Classes="h5" Text="Paid" />
                                    <icon:MaterialIcon Foreground="{DynamicResource AristeusSuccessColor}" Kind="Check" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </aristeus:AristeusSideMenu.Content>

                        <aristeus:AristeusSideMenu.ItemTemplate>
                            <DataTemplate>
                                <aristeus:AristeusSideMenuItem Header="{Binding BillingName}" Icon="{avalonia:MaterialIconExt Kind=Person}">
                                    <aristeus:AristeusSideMenuItem.SideDisplayTemplate>
                                        <DataTemplate DataType="{x:Type dashboard:InvoiceViewModel}">
                                            <Menu Height="32" Margin="0,-4" Padding="-2,0">
                                                <Menu.Resources>
                                                    <Color x:Key="AristeusGlassCardBackground">Transparent</Color>
                                                </Menu.Resources>
                                                <MenuItem Height="32" Width="33">
                                                    <MenuItem.Header>
                                                        <icon:MaterialIcon Height="24" Kind="DotsVertical" Width="24" />
                                                    </MenuItem.Header>
                                                    <MenuItem Header="Send Invoice" Icon="{avalonia:MaterialIconExt Kind=Payment}" />
                                                </MenuItem>
                                            </Menu>
                                        </DataTemplate>
                                    </aristeus:AristeusSideMenuItem.SideDisplayTemplate>
                                </aristeus:AristeusSideMenuItem>
                            </DataTemplate>
                        </aristeus:AristeusSideMenu.ItemTemplate>

                    </aristeus:AristeusSideMenu>
                </aristeus:GroupBox>
            </aristeus:GlassCard>

            <aristeus:GlassCard>
                <aristeus:GroupBox Header="Pill Tab Control">
                    <TabControl Classes="Pill">
                        <TabItem Classes="Pill" Header="Tab 1"></TabItem>
                        <TabItem Classes="Pill" Header="Tab 2"></TabItem>
                        <TabItem Classes="Pill" Header="Tab 3"></TabItem>
                    </TabControl>
                </aristeus:GroupBox>
            </aristeus:GlassCard>
        </WrapPanel>

    </ScrollViewer>
</UserControl>