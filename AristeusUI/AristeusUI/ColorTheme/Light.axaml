<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=netstandard">
    <Color x:Key="AristeusBackground">Transparent</Color>
    <Color x:Key="AristeusStrongBackground">#fcfcfc</Color>
    <Color x:Key="AristeusLightBackground">Transparent</Color>
    <Color x:Key="AristeusCardBackground">White</Color>
    <Color x:Key="AristeusPopupBackground">#fefefe</Color>
    <Color x:Key="AristeusGlassCardBackground">#fdfefefe</Color>
    <Color x:Key="AristeusGlassCardOpaqueBackground">#fcfcfc</Color>
    <Color x:Key="AristeusControlTouchBackground">#FFFFFF</Color>
    <Color x:Key="AristeusDialogBackground">Gray</Color>

    <Color x:Key="AristeusBorderBrush">#ebebeb</Color>
    <Color x:Key="AristeusControlBorderBrush">#cecece</Color>
    <Color x:Key="AristeusMediumBorderBrush">#e2e2e2</Color>
    <Color x:Key="AristeusLightBorderBrush">#f1f1f1</Color>
    <Color x:Key="AristeusMenuBorderBrush">#d7d7d7</Color>
    <Color x:Key="GlassBorderBrush">#e3e3e7</Color>

    <Color x:Key="AristeusText">#222222</Color>
    <Color x:Key="AristeusLowText">#555555</Color>
    <Color x:Key="AristeusMuteText">#7f7f7f</Color>
    <Color x:Key="AristeusDisabledText">#ABABAB</Color>
    
    <Color x:Key="AristeusLiquid1">#bb555555</Color>
    <Color x:Key="AristeusLiquid2">#77555555</Color>

    <BoxShadows x:Key="AristeusLowShadow">0 0 3 0 #eaeaea</BoxShadows>
    <BoxShadows x:Key="AristeusSwitchShadow">0 1 5 0 #aaaaaa</BoxShadows>
    <BoxShadows x:Key="AristeusSmallPopupShadow">0 2 5 0 LightGray</BoxShadows>
    <BoxShadows x:Key="AristeusPopupShadow">1 1 8 0 LightGray</BoxShadows>
    <BoxShadows x:Key="AristeusBigPopupShadow">1 4 17 0 #999999</BoxShadows>

    <Color x:Key="AristeusSuccessColor">#279f27</Color>
    <Color x:Key="AristeusSuccessMediumColor">#279f27</Color>
    <Color x:Key="AristeusSuccessDarkColor">#279f27</Color>
    <Color x:Key="AristeusSuccessForeground">White</Color>

    <Color x:Key="AristeusInformationColor">#2f54eb</Color>
    <Color x:Key="AristeusInformationMediumColor">#597ef7</Color>
    <Color x:Key="AristeusInformationDarkColor">#597ef7</Color>
    <Color x:Key="AristeusInformationForeground">White</Color>


    <Color x:Key="AristeusWarningColor">#fa8c16</Color>
    <Color x:Key="AristeusWarningMediumColor">#ffa940</Color>
    <Color x:Key="AristeusWarningDarkColor">#ffa940</Color>
    <Color x:Key="AristeusWarningForeground">White</Color>

    <Color x:Key="AristeusDangerColor">#f5222d</Color>
    <Color x:Key="AristeusDangerMediumColor">#ff4d4f</Color>
    <Color x:Key="AristeusDangerDarkColor">#ff4d4f</Color>
    <Color x:Key="AristeusDangerForeground">White</Color>

    <LinearGradientBrush x:Key="PopupGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#03111111" />
        <GradientStop Offset="1" Color="#02111111" />

    </LinearGradientBrush>

    <system:Boolean x:Key="IsDark">False</system:Boolean>
    <system:Boolean x:Key="IsLight">True</system:Boolean>

    <system:Double x:Key="GlassOpacity">0.48</system:Double>

    <system:Double x:Key="ControlGlassOpacity">0.05</system:Double>
    <system:Double x:Key="DiscreteControlGlassOpacity">0.4</system:Double>
    <Color x:Key="ControlAristeusGlassCardBackground">#fd111111</Color>
    
    
    <Color x:Key="AristeusNeedleBrush">#999999</Color>
    <Color x:Key="GaugeBackgroundBrush" >#aaffffff</Color>

</ResourceDictionary>
