<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=netstandard">
    <Color x:Key="AristeusBackground">Transparent</Color>
    <Color x:Key="AristeusStrongBackground">#353535</Color>
    <Color x:Key="AristeusLightBackground">Transparent</Color>
    <Color x:Key="AristeusCardBackground">#323232</Color>
    <Color x:Key="AristeusPopupBackground">#252525</Color>
    <Color x:Key="AristeusGlassCardBackground">#49aaaaaa</Color>
    <Color x:Key="AristeusGlassCardOpaqueBackground">#333333</Color>
    <Color x:Key="AristeusControlTouchBackground">#505050</Color>
    <Color x:Key="AristeusDialogBackground">#000000</Color>

    <Color x:Key="AristeusBorderBrush">#353535</Color>
    <Color x:Key="AristeusControlBorderBrush">#606060</Color>
    <Color x:Key="AristeusMediumBorderBrush">#555555</Color>
    <Color x:Key="AristeusLightBorderBrush">#454545</Color>
    <Color x:Key="AristeusMenuBorderBrush">#454545</Color>
    <Color x:Key="GlassBorderBrush">#252729</Color>

    <Color x:Key="AristeusText">#edffffff</Color>
    <Color x:Key="AristeusLowText">#caffffff</Color>
    <Color x:Key="AristeusMuteText">#b4b4b4</Color>
    <Color x:Key="AristeusDisabledText">#ca727272</Color>
    
    <Color x:Key="AristeusLiquid1">#ffffff</Color>
    <Color x:Key="AristeusLiquid2">#aaffffff</Color>

    <BoxShadows x:Key="AristeusLowShadow">0 0 3 0 #353535</BoxShadows>
    <BoxShadows x:Key="AristeusSwitchShadow">0 1 5 0 #555555</BoxShadows>
    <BoxShadows x:Key="AristeusSmallPopupShadow">0 0 4 1 #101010</BoxShadows>
    <BoxShadows x:Key="AristeusPopupShadow">1 1 14 1 #101010</BoxShadows>
    <BoxShadows x:Key="AristeusBigPopupShadow">1 4 17 0 #111111</BoxShadows>

    <Color x:Key="AristeusSuccessColor">#cc228b22</Color>
    <Color x:Key="AristeusSuccessMediumColor">#cc1d771d</Color>
    <Color x:Key="AristeusSuccessDarkColor">#cc1d771d</Color>
    <Color x:Key="AristeusSuccessForeground">White</Color>

    <Color x:Key="AristeusInformationColor">#cc2f54eb</Color>
    <Color x:Key="AristeusInformationMediumColor">#cc1d39c4</Color>
    <Color x:Key="AristeusInformationDarkColor">#cc1d39c4</Color>
    <Color x:Key="AristeusInformationForeground">White</Color>


    <Color x:Key="AristeusWarningColor">#ccfa8c16</Color>
    <Color x:Key="AristeusWarningMediumColor">#ccad4e00</Color>
    <Color x:Key="AristeusWarningDarkColor">#ccad4e00</Color>
    <Color x:Key="AristeusWarningForeground">White</Color>

    <Color x:Key="AristeusDangerColor">#bbf5222d</Color>
    <Color x:Key="AristeusDangerMediumColor">#bba8071a</Color>
    <Color x:Key="AristeusDangerDarkColor">#bba8071a</Color>
    <Color x:Key="AristeusDangerForeground">White</Color>

    <LinearGradientBrush x:Key="PopupGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="{DynamicResource AristeusPrimaryColor3}" />
        <GradientStop Offset="0.9" Color="{DynamicResource AristeusPrimaryColor10}" />

    </LinearGradientBrush>

    <system:Boolean x:Key="IsDark">True</system:Boolean>
    <system:Boolean x:Key="IsLight">False</system:Boolean>

    <system:Double x:Key="GlassOpacity">0.18</system:Double>

    <system:Double x:Key="ControlGlassOpacity">0.3</system:Double>
    <system:Double x:Key="DiscreteControlGlassOpacity">0.17</system:Double>
    <Color x:Key="ControlAristeusGlassCardBackground">#49aaaaaa</Color>
    
    <Color x:Key="AristeusNeedleBrush">#ffffff</Color>
    <LinearGradientBrush x:Key="GaugeBackgroundBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="{DynamicResource AristeusPrimaryColor1}" />
        <GradientStop Offset="0.9" Color="{DynamicResource AristeusPrimaryColor3}" />

    </LinearGradientBrush>
 
</ResourceDictionary>