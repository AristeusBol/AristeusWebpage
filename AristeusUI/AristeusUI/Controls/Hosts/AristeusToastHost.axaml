<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:aristeus="https://github.com/kikipoulet/AristeusUI">
    <ControlTheme x:Key="AristeusToastHostTheme" TargetType="aristeus:AristeusToastHost">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <!--
                <DockPanel VerticalAlignment="{TemplateBinding VerticalAlignment}" LastChildFill="True" />
                -->
                <DockPanel  LastChildFill="True" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter/>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type aristeus:AristeusToastHost}"
                  BasedOn="{StaticResource AristeusToastHostTheme}"
                  TargetType="aristeus:AristeusToastHost" />
</ResourceDictionary>
