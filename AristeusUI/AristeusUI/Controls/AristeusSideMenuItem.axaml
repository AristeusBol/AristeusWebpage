<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:content="clr-namespace:AristeusUI.Content"
                    xmlns:converters="https://github.com/kikipoulet/AristeusUI"
                    xmlns:aristeus="clr-namespace:AristeusUI.Controls">
    <Design.PreviewWith>
        <aristeus:AristeusSideMenu>
            <aristeus:AristeusSideMenuItem Header="Header">
                <aristeus:AristeusSideMenuItem.Icon>
                    <PathIcon Width="13"
                              Height="13"
                              Data="{x:Static content:Icons.Cross}" />
                </aristeus:AristeusSideMenuItem.Icon>

            </aristeus:AristeusSideMenuItem>
            <aristeus:AristeusSideMenuItem Header="Header">
                <aristeus:AristeusSideMenuItem.Icon>
                    <PathIcon Width="13"
                              Height="13"
                              Data="{x:Static content:Icons.Cross}" />
                </aristeus:AristeusSideMenuItem.Icon>
                <Grid />
            </aristeus:AristeusSideMenuItem>
        </aristeus:AristeusSideMenu>
    </Design.PreviewWith>
    <ControlTheme x:Key="AristeusSideMenuItemStyle" TargetType="aristeus:AristeusSideMenuItem">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <Panel DockPanel.Dock="Bottom" IsVisible="{Binding IsMenuExpanded, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type aristeus:AristeusSideMenu}}}">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        Margin="20,0,0,0"
                                        IsVisible="{TemplateBinding IsExpanded}"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Panel>
                    <Border Name="PART_Border"
                            MinWidth="85"
                            Margin="15,2"
                            Padding="30,15,15,15"
                            Background="{DynamicResource AristeusPrimaryColor0}"
                            CornerRadius="{DynamicResource MediumCornerRadius}">

                        <Border.Transitions>
                            <Transitions>
                                <DoubleTransition Property="MaxHeight" Duration="0:0:1">
                                    <DoubleTransition.Easing>CubicEaseInOut</DoubleTransition.Easing>
                                </DoubleTransition>
                                <BrushTransition Property="Background" Duration="0:0:0.35" />
                                <ThicknessTransition Property="Padding" Duration="0:0:0.35">
                                    <ThicknessTransition.Easing>CubicEaseInOut</ThicknessTransition.Easing>
                                </ThicknessTransition>
                            </Transitions>
                        </Border.Transitions>
                        <Panel>
                            <DockPanel Name="PART_NormalDisplay" LastChildFill="True">
                                <DockPanel.Resources />
                                <DockPanel.Styles>
                                    <Style Selector="ToggleButton[IsChecked=True]">
                                        <Setter Property="RenderTransform" Value="rotate(-180deg)" />
                                    </Style>
                                </DockPanel.Styles>
                                <ToggleButton Name="PART_ExpandedButton"
                                              Margin="0,0,-8,0"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Classes="CircleGlass"
                                              DockPanel.Dock="Right"
                                              Focusable="False"
                                              IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                              IsVisible="{TemplateBinding ItemCount}">
                                    <ToggleButton.Transitions>
                                        <Transitions>
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" />
                                        </Transitions>
                                    </ToggleButton.Transitions>
                                    <PathIcon Width="10"
                                              Height="10"
                                              Margin="0,2,0,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="{x:Static content:Icons.ChevronDown}"
                                              Foreground="{DynamicResource AristeusLowText}" />

                                </ToggleButton>

                                <ContentControl Name="PART_Icon"
                                                Width="24"
                                                Height="24"
                                                Content="{TemplateBinding Icon}"
                                                DockPanel.Dock="Left">
                                    <ContentControl.Transitions>
                                        <Transitions>
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                                        </Transitions>
                                    </ContentControl.Transitions>
                                </ContentControl>
                                <Grid Name="PART_SideDisplay"
                                      DockPanel.Dock="Right"
                                      IsVisible="{Binding IsMenuExpanded, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type aristeus:AristeusSideMenu}}}">
                                    <ContentPresenter Name="PART_SideDisplayContent"
                                                      Content="{TemplateBinding DataContext}"
                                                      ContentTemplate="{TemplateBinding SideDisplayTemplate}"
                                                      Margin="5,0"
                                                      IsVisible="{Binding SideDisplayTemplate, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </Grid>
                                <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly">
                                    <TextBlock Name="PART_Header"
                                               Margin="15,0"
                                               VerticalAlignment="Center"
                                               FontSize="{TemplateBinding FontSize}"
                                               IsVisible="{Binding IsMenuExpanded, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type aristeus:AristeusSideMenu}}}"
                                               Text="{TemplateBinding Header}" />
                                </Viewbox>
                            </DockPanel>
                            <!-- <ContentPresenter Name="PART_AltDisplay"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />-->


                        </Panel>
                    </Border>

                </DockPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[IsTopMenuExpanded=False] /template/ ToggleButton#PART_ExpandedButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^.Compact /template/ Border#PART_Border">
            <Setter Property="Padding" Value="30,10,15,10" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="^:pointerover">
            <Style Selector="^ /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource AristeusPrimaryColor5}" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </Style>
        <Style Selector="^[IsSelected=True]">
            <Style Selector="^ /template/ Border#PART_Border">
                <Setter Property="Background" Value="{DynamicResource AristeusPrimaryColor10}" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PART_Header">
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource AristeusPrimaryColor120}" />
            </Style>
            <Style Selector="^[IsContentMovable=True]">
                <Style Selector="^[IsTopMenuExpanded=True] /template/ Border#PART_Border">
                    <Setter Property="Padding" Value="-10,15,15,15" />
                </Style>
                <Style Selector="^.Compact[IsTopMenuExpanded=True] /template/ Border#PART_Border">
                    <Setter Property="Padding" Value="-10,10,15,10" />
                </Style>
                <Style Selector="^[IsTopMenuExpanded=True] /template/ ContentControl#PART_Icon">
                    <Setter Property="Opacity" Value="0" />
                </Style>

                <Style Selector="^[IsTopMenuExpanded=False] /template/ ContentControl#PART_Icon">
                    <Setter Property="Foreground" Value="{DynamicResource AristeusPrimaryColor}" />
                    <Setter Property="RenderTransform">
                        <ScaleTransform ScaleX="1.12" ScaleY="1.12" />
                    </Setter>
                </Style>
            </Style>
            <Style Selector="^[IsContentMovable=False]">
                <Style Selector="^ /template/ ContentControl#PART_Icon">
                    <Setter Property="Foreground" Value="{DynamicResource AristeusPrimaryColor}" />
                </Style>
            </Style>
        </Style>
        <Setter Property="FontSize" Value="14" />
    </ControlTheme>
    <ControlTheme x:Key="{x:Type aristeus:AristeusSideMenuItem}"
                  BasedOn="{StaticResource AristeusSideMenuItemStyle}"
                  TargetType="aristeus:AristeusSideMenuItem" />
</ResourceDictionary>
