<Styles x:Class="AristeusUI.AristeusTheme"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:animations="clr-namespace:AristeusUI.Animations"
        xmlns:system="clr-namespace:System;assembly=netstandard">

    <SimpleTheme />

    <StyleInclude Source="avares://AristeusUI/Theme/TextStyles.axaml" />
    <StyleInclude Source="avares://AristeusUI/Theme/SettingsLayoutStyles.axaml" />

    <StyleInclude Source="avares://AristeusUI/Theme/ComboBoxStyles.xaml" />
    <StyleInclude Source="avares://AristeusUI/Theme/Colors.xaml" />

    <StyleInclude Source="avares://AristeusUI/Theme/BorderStyles.xaml" />

    <StyleInclude Source="avares://AristeusUI/Theme/ListBoxStyles.xaml" />
    <StyleInclude Source="avares://AristeusUI/Theme/TreeViewStyles.xaml" />

    <StyleInclude Source="avares://AristeusUI/Theme/ToolTipStyles.axaml" />
    <StyleInclude Source="avares://AristeusUI/Theme/RadioButtonStyles.xaml" />
    <StyleInclude Source="avares://AristeusUI/Theme/SliderStyles.xaml" />
    <StyleInclude Source="avares://AristeusUI/Theme/DataGridStyle.axaml" />
    <StyleInclude Source="avares://AristeusUI/Theme/ListBoxItemStyle.axaml" />
    <StyleInclude Source="avares://AristeusUI/Theme/ComboBoxItemStyle.axaml" />
    <StyleInclude Source="avares://AristeusUI/Theme/NotificationStyle.axaml" />
    <StyleInclude Source="avares://AristeusUI/Theme/NotificationCardStyle.axaml" />
    <StyleInclude Source="avares://AristeusUI/Theme/CheckBoxStyles.axaml" />
    <StyleInclude Source="avares://AristeusUI/Theme/ScrollBarStyle.axaml" />
    <StyleInclude Source="avares://AristeusUI/Theme/ScrollViewerStyles.axaml" />
    <StyleInclude Source="avares://AristeusUI/Theme/ButtonLoadingStyles.axaml" />
    <StyleInclude Source="avares://AristeusUI/Theme/TabItemGlassStyles.xaml" />
    <StyleInclude Source="avares://AristeusUI/Theme/GridSplitterStyles.axaml"/>
    <StyleInclude Source="avares://AristeusUI/Controls/Gauges/HorizontalBarMeter/HorizontalBarMeterStyles.axaml"/>
    <StyleInclude Source="avares://AristeusUI/Controls/Gauges/VerticalBarMeter/VerticalBarMeterStyles.axaml"/>
    <StyleInclude Source="avares://AristeusUI/Controls/Gauges/RadialGauge/RadialGaugeStyles.axaml"/>


    <Styles.Resources>
        <ResourceDictionary>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Light" Source="../ColorTheme/Light.axaml" />
                <ResourceInclude x:Key="Dark" Source="../ColorTheme/Dark.axaml" />
            </ResourceDictionary.ThemeDictionaries>

            <CornerRadius x:Key="SmallCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="MediumCornerRadius">15</CornerRadius>

            <system:TimeSpan x:Key="LongAnimationDuration">0.5</system:TimeSpan>
            <system:TimeSpan x:Key="MediumAnimationDuration">0.35</system:TimeSpan>
            <system:TimeSpan x:Key="ShortAnimationDuration">0.2</system:TimeSpan>

            <animations:AristeusEaseOutBack x:Key="MenuEasing" BounceIntensity="Soft" />


            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://aristeusUI/Theme/TextBlock.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/ColorPickerStyle.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/TextBox.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/NumericUpDown.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/Button.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/ToggleButton.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/ToggleSwitch.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/SplitButton.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/ProgressBar.axaml" />
                <ResourceInclude Source="avares://AristeusUI/Theme/SplitView.axaml" />
                <ResourceInclude Source="avares://AristeusUI/Theme/DatePicker.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/HyperlinkButton.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/PathIcon.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/Expander.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/CalendarDatePickerStyle.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/TabControl.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/TabItem.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/Separator.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/DropDownButton.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/Menu.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/ContextMenu.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/MenuItem.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/FlyoutPresenter.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/MenuFlyoutPresenter.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/AutoCompleteBoxStyles.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/ManagedFileChooser.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/TextResetButton.axaml" />
                <ResourceInclude Source="avares://AristeusUI/Theme/TreeViewItem.axaml" />

                <ResourceInclude Source="avares://aristeusUI/Theme/TimePickerStyle.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/Calendar/Calendar.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/Calendar/CalendarButton.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/Calendar/CalendarDayButton.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Theme/Calendar/CalendarItem.axaml" />

                <ResourceInclude Source="avares://aristeusUI/Controls/AristeusMainHost.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Controls/AristeusWindow.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Controls/AristeusToast.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Controls/Hosts/AristeusToastHost.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Controls/Hosts/AristeusDialogHost.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Controls/Hosts/AristeusMessageBoxHost.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Controls/GroupBox.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Controls/AristeusDialog.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Controls/AristeusSideMenu.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Controls/AristeusStackPage.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Controls/AristeusSideMenuItem.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Controls/AristeusTransitioningContentControl.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Controls/Stepper.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Controls/VerticalStepper.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Controls/InfoBadge.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Controls/InfoBar.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Controls/GlassMorphism/GlassCard.axaml" />
                <ResourceInclude Source="avares://aristeusUI/Controls/ContentExpandControl.axaml" />

                <ResourceInclude Source="avares://AristeusUI/Locale/en-US.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>