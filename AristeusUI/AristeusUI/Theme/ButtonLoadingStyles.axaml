<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:aristeus="https://github.com/kikipoulet/AristeusUI">
    <Design.PreviewWith>
        <Border Padding="20">
            <!--  Add Controls for Previewer Here  -->
        </Border>
    </Design.PreviewWith>

    <Style Selector="Button aristeus|Loading">
        <Setter Property="Foreground" Value="{DynamicResource AristeusText}" />
    </Style>

    <Style Selector="Button.Outlined aristeus|Loading">
        <Setter Property="Foreground" Value="{DynamicResource AristeusPrimaryColor}" />
    </Style>

    <Style Selector="Button.Basic aristeus|Loading">
        <Setter Property="Foreground" Value="{DynamicResource AristeusPrimaryColor}" />
    </Style>

    <Style Selector="Button.Accent aristeus|Loading">
        <Setter Property="Foreground" Value="{DynamicResource AristeusAccentColor}" />
    </Style>


    <Style Selector="Button.Flat aristeus|Loading">
        <Setter Property="Foreground" Value="White" />
    </Style>


</Styles>
