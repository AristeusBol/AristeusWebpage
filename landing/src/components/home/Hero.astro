---
import Button from '../shared/Button.astro';
import Icon from '../icons/Icon';
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background image with overlay -->
  <div class="absolute inset-0">
    <img 
      src="https://images.unsplash.com/photo-1500382017468-9049fed747ef?w=1920&q=80" 
      alt="Pasture satellite view"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-bg-primary/92 via-bg-primary/78 to-bg-secondary/72"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(107,165,57,0.18),transparent_32%),radial-gradient(circle_at_left_center,rgba(11,35,65,0.12),transparent_36%)]"></div>
  </div>
  
  <!-- Content -->
  <div class="relative z-10 text-center px-4 max-w-5xl mx-auto pt-20">
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass border border-aristeus-green/35 shadow-[0_10px_30px_rgba(11,35,65,0.08)] mb-6 animate-fade-in">
      <span class="text-aristeus-green"><Icon name="drone" class="w-6 h-6" client:only="react" /></span>
      <span class="text-sm text-text-secondary">
        Tecnología de vanguardia para el ganadero moderno
      </span>
    </div>
    
    <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold text-text-primary mb-6 leading-tight animate-fade-up" style="animation-delay: 0.1s;">
      <span>Tecnología de vanguardia para una ganadería más rentable y sostenible</span>
    </h1>
    
    <p class="text-text-secondary text-lg md:text-xl lg:text-2xl max-w-3xl mx-auto mb-10 animate-fade-up" style="animation-delay: 0.2s;">
      Medimos la biomasa de tus pastizales con Machine Learning para que cada hectárea rinda al máximo sin degradar tu tierra
    </p>
    
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-up" style="animation-delay: 0.3s;">
      <Button 
        text="Solicita tu análisis gratuito" 
        href="#contacto" 
        variant="primary" 
        color="green" 
        size="lg"
        class="w-full sm:w-auto"
      />
      <Button 
        text="Ver cómo funciona ↓" 
        href="#como-funciona" 
        variant="outline" 
        color="navy" 
        size="lg"
        class="w-full sm:w-auto"
      />
    </div>
    
    <!-- Stats bar -->
    <div class="mt-16 md:mt-24 glass rounded-xl p-6 inline-flex flex-wrap items-center justify-center gap-6 md:gap-12 shadow-[0_16px_36px_rgba(11,35,65,0.08)] animate-fade-up" style="animation-delay: 0.4s;">
      <div class="text-center">
        <div class="font-data text-2xl md:text-3xl text-aristeus-green font-semibold">10,000+</div>
        <div class="text-text-secondary text-sm">ha posibles de adquisición por día</div>
      </div>
      <div class="w-px h-10 bg-border-subtle hidden sm:block"></div>
      <div class="text-center">
        <div class="font-data text-2xl md:text-3xl text-aristeus-green font-semibold">93%</div>
        <div class="text-text-secondary text-sm">precisión</div>
      </div>
      <div class="w-px h-10 bg-border-subtle hidden sm:block"></div>
      <div class="text-center">
        <div class="font-data text-2xl md:text-3xl text-aristeus-green font-semibold">1</div>
        <div class="text-text-secondary text-sm"> modelo testeado en Bolivia</div>
      </div>
    </div>
  </div>
  
  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <Icon name="chevronDown" class="w-6 h-6 text-text-secondary" client:only="react" />
  </div>
</section>
