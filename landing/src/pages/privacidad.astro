---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Privacidad" description="Política de privacidad de Aristeus">
  <section class="py-20 md:py-32 bg-bg-primary min-h-[80vh]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-heading text-4xl md:text-5xl font-bold text-text-primary mb-4">
        Política de privacidad
      </h1>
      <p class="text-text-secondary text-lg">
        Contenido próximamente.
      </p>
    </div>
  </section>
</BaseLayout>
